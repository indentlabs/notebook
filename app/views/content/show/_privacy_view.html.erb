<!-- Privacy Management Interface -->
<div class="max-w-4xl mx-auto space-y-6">
  <%= render 'content/shared/privacy_settings', raw_content: raw_content %>

  <!-- Universe Inheritance (if applicable) -->
  <% if raw_content.respond_to?(:universe) && raw_content.universe.present? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4">
      <div class="mb-3">
        <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-1 flex items-center">
          <i class="material-icons text-sm <%= Universe.text_color %> mr-2"><%= Universe.icon %></i>
          Universe Privacy
        </h3>
        <p class="text-xs text-gray-600 dark:text-gray-400">This page belongs to a universe with its own privacy settings</p>
      </div>

      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900 dark:to-indigo-900 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 rounded-lg <%= Universe.color %> flex items-center justify-center">
              <i class="material-icons text-xs text-white"><%= Universe.icon %></i>
            </div>
          </div>
          <div class="ml-3 flex-1">
            <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-1"><%= raw_content.universe.name %></div>
            <div class="flex items-center mb-1">
              <span class="text-xs text-gray-600 dark:text-gray-400 mr-2">Universe is:</span>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= raw_content.universe.privacy == 'public' ? 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-300' : 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300' %>">
                <i class="material-icons text-xs mr-1"><%= raw_content.universe.privacy_icon %></i>
                <%= raw_content.universe.privacy_label %>
              </span>
            </div>

            <% if (raw_content.universe.privacy || 'private') == 'public' %>
              <div class="bg-blue-100 dark:bg-blue-900 border border-blue-200 dark:border-blue-800 rounded p-2 mt-2">
                <div class="flex items-start">
                  <i class="material-icons text-blue-600 dark:text-blue-300 text-sm mr-2 mt-0.5">bolt</i>
                  <div>
                    <div class="text-xs font-medium text-blue-900 dark:text-blue-100">Universe Override Active</div>
                    <div class="text-xs text-blue-700 dark:text-blue-300">All pages in this universe are automatically public, except password protected ones</div>
                  </div>
                </div>
              </div>
            <% elsif raw_content.universe.password_protected? %>
              <div class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                The universe's password only opens the universe's own page. Individual page privacy settings apply, as they would in a private universe.
              </div>
            <% else %>
              <div class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                Individual page privacy settings apply
              </div>
            <% end %>
          </div>
          <div class="ml-3 flex-shrink-0">
            <%= link_to raw_content.universe,
                        class: "inline-flex items-center px-3 py-1.5 bg-white dark:bg-gray-700 border border-blue-300 dark:border-blue-600 rounded text-xs font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-800 transition-colors" do %>
              <i class="material-icons text-xs mr-1">settings</i>
              Manage
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Action Info -->
  <div class="flex justify-center pt-4 border-t border-gray-200 dark:border-gray-700">
    <div class="text-xs text-gray-500 dark:text-gray-400 flex items-center">
      <i class="material-icons text-xs mr-2">info</i>
      Changes are saved automatically
    </div>
  </div>

</div>
