<%#
  Public gallery on content#show: the same images, order and privacy rules
  as the editor, opened in a lightbox (app/javascript/controllers/lightbox_controller.js).

  Locals:
    content     - serialized content (labels only)
    raw_content - the page record
%>
<%
  images    = ContentImage.gallery_for(raw_content, viewer: current_user)
  can_edit  = user_signed_in? && ContentImageAuthorization.can_manage?(current_user, raw_content)
  page_name = raw_content.try(:name).presence || content.try(:name)
  edit_base = can_edit ? polymorphic_path(raw_content, action: :edit) : nil
%>

<% if images.any? %>
  <div data-controller="lightbox"
       data-lightbox-page-name-value="<%= page_name %>">
    <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      <% images.each_with_index do |image, index| %>
        <%
          thumb_url = image.url(:large)
          full_url  = image.url(:xlarge) || image.original_url
          caption   = image.notes.presence
          next if thumb_url.nil?
        %>
        <button type="button"
                class="gallery-item group relative block w-full text-left bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                data-lightbox-target="item"
                data-action="lightbox#open"
                data-index="<%= index %>"
                data-image-id="<%= image.dom_id %>"
                data-full="<%= full_url %>"
                data-caption="<%= caption %>"
                data-source="<%= image.source_label %>"
                data-download="<%= image.download_url %>"
                data-edit-url="<%= edit_base ? "#{edit_base}#gallery/#{image.dom_id}" : '' %>"
                aria-label="<%= caption.presence || "#{page_name} image #{index + 1}" %>. Open larger.">
          <%= image_tag thumb_url,
                class: 'w-full h-64 object-cover',
                style: "object-position: #{image.object_position}",
                loading: 'lazy',
                decoding: 'async',
                alt: caption.presence || "#{page_name} image #{index + 1}" %>

          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-25 group-focus-visible:bg-opacity-25 transition-opacity duration-200 flex items-center justify-center pointer-events-none">
            <i class="material-icons text-white text-3xl opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-200">zoom_in</i>
          </div>

          <% if image.cover? %>
            <span class="absolute top-2 left-2 inline-flex items-center px-2 py-1 rounded-full bg-yellow-400 text-yellow-900 text-xs font-semibold shadow-sm">
              <i class="material-icons text-xs mr-1">star</i> Cover
            </span>
          <% end %>

          <% if caption %>
            <span class="absolute inset-x-0 bottom-0 px-3 py-2 text-sm text-white bg-gradient-to-t from-black to-transparent truncate">
              <%= caption %>
            </span>
          <% end %>
        </button>
      <% end %>
    </div>

    <%= render partial: 'content/show/lightbox' %>
  </div>

<% else %>
  <!-- Empty gallery state -->
  <div class="text-center py-12">
    <div class="mx-auto h-16 w-16 bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center mb-4">
      <i class="material-icons text-2xl text-gray-400 dark:text-gray-500">photo_library</i>
    </div>
    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No images yet</h3>
    <p class="text-gray-500 dark:text-gray-400 mb-6">
      This <%= content.class_name.downcase %> doesn't have any images uploaded yet.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <% if can_edit %>
        <%= link_to "#{polymorphic_path(raw_content, action: :edit)}#gallery",
                    class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white #{content.class_color} hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <i class="material-icons text-lg mr-2">add_photo_alternate</i>
          Upload Images
        <% end %>

        <% if BasilService::ENABLED_PAGE_TYPES.include?(raw_content.class.name) %>
          <%= link_to basil_content_path(raw_content.page_type.downcase, raw_content.id),
                      class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
            <i class="material-icons text-lg mr-2">auto_fix_high</i>
            Visualize
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
