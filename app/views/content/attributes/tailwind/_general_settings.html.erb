<div class="p-4">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-lg font-medium text-gray-900 dark:text-gray-100 flex items-center">
      <i class="material-icons text-gray-600 dark:text-gray-400 mr-2">settings</i>
      General Settings
    </h2>
    <button @click="configuring = false; selectedCategory = null; selectedField = null;" 
            class="p-1.5 rounded hover:bg-gray-100 dark:hover:bg-slate-700" 
            title="Close Settings">
      <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div class="space-y-6">
    <!-- Template Information -->
    <div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4">
      <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-2 flex items-center">
        <i class="material-icons text-gray-600 dark:text-gray-400 mr-2 text-lg"><%= content_type_class.icon %></i>
        <%= content_type.titleize %> Template
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">
        This template defines the structure and fields for your <%= content_type.titleize.downcase %> pages.
      </p>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500 dark:text-gray-400">Categories:</span>
          <span class="ml-1 font-medium text-gray-900 dark:text-gray-100 general-settings-categories-count"><%= @attribute_categories.count %></span>
        </div>
        <div>
          <span class="text-gray-500 dark:text-gray-400">Total Fields:</span>
          <span class="ml-1 font-medium text-gray-900 dark:text-gray-100 general-settings-fields-count"><%= @attribute_categories.sum { |cat| cat.attribute_fields.count } %></span>
        </div>
      </div>
    </div>

    <!-- Template Actions -->
    <div>
      <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-3">Template Actions</h3>
      <div class="space-y-2">
        <div class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden" x-data="{ exportOpen: false }">
          <button @click="exportOpen = !exportOpen" 
                  class="w-full flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors text-left">
            <div class="flex items-center">
              <i class="material-icons text-gray-600 dark:text-gray-400 mr-3">file_download</i>
              <div>
                <div class="font-medium text-gray-900 dark:text-gray-100">Export Template</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Download this template configuration</div>
              </div>
            </div>
            <i class="material-icons text-gray-400 transition-transform" 
               :class="{ 'rotate-180': exportOpen }">expand_more</i>
          </button>
          <div x-show="exportOpen" 
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 transform scale-95"
               x-transition:enter-end="opacity-100 transform scale-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100 transform scale-100"
               x-transition:leave-end="opacity-0 transform scale-95"
               class="border-t border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700 p-3">
            <div class="grid grid-cols-2 gap-2">
              <!-- Technical Formats Row -->
              <a href="<%= export_template_path(content_type: content_type, format: 'yml') %>" 
                 class="px-3 py-2 text-sm bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md hover:bg-gray-50 dark:hover:bg-slate-700 text-center dark:text-gray-200 transition-colors">
                <i class="material-icons text-xs mr-1">code</i>
                YAML
              </a>
              <a href="<%= export_template_path(content_type: content_type, format: 'json') %>"
                 class="px-3 py-2 text-sm bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md hover:bg-gray-50 dark:hover:bg-slate-700 text-center dark:text-gray-200 transition-colors">
                <i class="material-icons text-xs mr-1">data_object</i>
                JSON
              </a>
              
              <!-- User-Friendly Formats Row -->
              <a href="<%= export_template_path(content_type: content_type, format: 'md') %>"
                 class="px-3 py-2 text-sm bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md hover:bg-gray-50 dark:hover:bg-slate-700 text-center dark:text-gray-200 transition-colors">
                <i class="material-icons text-xs mr-1">description</i>
                Markdown
              </a>
              <a href="<%= export_template_path(content_type: content_type, format: 'csv') %>"
                 class="px-3 py-2 text-sm bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md hover:bg-gray-50 dark:hover:bg-slate-700 text-center dark:text-gray-200 transition-colors">
                <i class="material-icons text-xs mr-1">table_chart</i>
                CSV
              </a>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
              YAML/JSON for technical users, Markdown/CSV for human readability.
            </p>
          </div>
        </div>
        
        <div class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden" x-data="templateImportComponent()">
          <button @click="importOpen = !importOpen"
                  class="w-full flex items-center justify-between p-3 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors text-left">
            <div class="flex items-center">
              <i class="material-icons text-gray-600 dark:text-gray-400 mr-3">file_upload</i>
              <div>
                <div class="font-medium text-gray-900 dark:text-gray-100">Import Template</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Load a saved template configuration</div>
              </div>
            </div>
            <i class="material-icons text-gray-400 transition-transform" 
               :class="{ 'rotate-180': importOpen }">expand_more</i>
          </button>
          <div x-show="importOpen" 
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 transform scale-95"
               x-transition:enter-end="opacity-100 transform scale-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100 transform scale-100"
               x-transition:leave-end="opacity-0 transform scale-95"
               class="border-t border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700 p-4 space-y-4">

            <!-- File Picker -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Template file</label>
              <input type="file"
                     accept=".yml,.yaml,.json,.csv"
                     @change="selectFile($event)"
                     class="template-import-file block w-full text-sm text-gray-700 dark:text-gray-300">
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                Accepts the YAML, JSON, and CSV files produced by Export Template.
              </p>
            </div>

            <!-- Import Mode -->
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">How should we apply it?</label>
              <div class="space-y-2">
                <label class="flex items-start p-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-md cursor-pointer">
                  <input type="radio" name="template_import_mode" value="merge" x-model="mode" @change="analysis = null"
                         class="h-4 w-4 mt-0.5 mr-2 border-gray-300 dark:border-slate-500"
                         style="color: var(--content-type-color);">
                  <span>
                    <span class="block text-sm font-medium text-gray-900 dark:text-gray-100">Merge</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400">Add anything missing and update what matches. Nothing is deleted.</span>
                  </span>
                </label>
                <label class="flex items-start p-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-md cursor-pointer">
                  <input type="radio" name="template_import_mode" value="replace" x-model="mode" @change="analysis = null"
                         class="h-4 w-4 mt-0.5 mr-2 border-gray-300 dark:border-slate-500"
                         style="color: var(--content-type-color);">
                  <span>
                    <span class="block text-sm font-medium text-gray-900 dark:text-gray-100">Replace</span>
                    <span class="block text-xs text-gray-500 dark:text-gray-400">Make this template match the file exactly. Fields you have that aren't in the file are deleted.</span>
                  </span>
                </label>
              </div>
            </div>

            <!-- Loading -->
            <div x-show="loading" class="text-center py-4">
              <div class="animate-spin rounded-full h-6 w-6 border-b-2 mx-auto mb-2" style="border-color: var(--content-type-color);"></div>
              <p class="text-sm text-gray-600 dark:text-gray-300" x-text="importing ? 'Importing template...' : 'Reading template...'"></p>
            </div>

            <!-- Error -->
            <div x-show="error" class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 rounded-md p-3">
              <p class="text-sm text-red-800 dark:text-red-200" x-text="error"></p>
            </div>

            <!-- Preview -->
            <div x-show="analysis && !loading" class="space-y-3">
              <div class="bg-white dark:bg-slate-800 rounded-md p-3 border border-gray-200 dark:border-slate-600">
                <h4 class="font-medium text-gray-900 dark:text-gray-100 mb-2 flex items-center">
                  <i class="material-icons text-gray-600 dark:text-gray-400 mr-2 text-lg">preview</i>
                  Import Preview
                </h4>
                <div class="text-sm text-gray-700 dark:text-gray-300 space-y-1">
                  <p x-show="analysis?.counts?.categories_created > 0">
                    <strong x-text="analysis?.counts?.categories_created"></strong> new categories
                  </p>
                  <p x-show="analysis?.counts?.fields_created > 0">
                    <strong x-text="analysis?.counts?.fields_created"></strong> new fields
                  </p>
                  <p x-show="analysis?.counts?.categories_updated > 0 || analysis?.counts?.fields_updated > 0">
                    <strong x-text="(analysis?.counts?.categories_updated || 0) + (analysis?.counts?.fields_updated || 0)"></strong> existing items updated
                  </p>
                  <p x-show="analysis?.counts?.fields_removed > 0" class="text-red-700 dark:text-red-300 font-medium">
                    <strong x-text="analysis?.counts?.fields_removed"></strong> fields removed
                  </p>
                  <p x-show="isNoop()" class="text-gray-500 dark:text-gray-400">
                    This file already matches your template — nothing would change.
                  </p>
                </div>
              </div>

              <!-- Warnings -->
              <template x-for="warning in (analysis?.warnings || [])" :key="warning">
                <div class="bg-amber-50 dark:bg-slate-800 border border-amber-200 dark:border-amber-700 rounded-md p-3">
                  <p class="text-sm text-amber-800 dark:text-amber-200" x-text="warning"></p>
                </div>
              </template>

              <!-- Data loss -->
              <div x-show="analysis?.filled_answers_at_risk > 0"
                   class="bg-red-50 dark:bg-red-900 border border-red-300 dark:border-red-700 rounded-md p-3">
                <h5 class="font-medium text-red-900 dark:text-red-100 mb-1">⚠️ Data Loss Warning</h5>
                <p class="text-sm text-red-800 dark:text-red-200">
                  <strong x-text="analysis?.filled_answers_at_risk"></strong> written answers across
                  <strong x-text="analysis?.affected_pages_count"></strong> pages will be permanently deleted.
                </p>
                <div class="text-xs text-red-800 dark:text-red-200 mt-2 space-y-0.5 max-h-32 overflow-y-auto">
                  <template x-for="removal in (analysis?.fields_to_remove || [])" :key="removal.category + removal.field">
                    <p x-show="removal.filled_count > 0">
                      <strong x-text="removal.category"></strong> → <span x-text="removal.field"></span>
                      (<span x-text="removal.filled_count"></span> answers)
                    </p>
                  </template>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end space-x-2">
              <button type="button" @click="reset()"
                      class="px-3 py-1.5 border border-gray-300 dark:border-slate-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-700 hover:bg-gray-50 dark:hover:bg-slate-600">
                Cancel
              </button>
              <button type="button"
                      x-show="!analysis"
                      @click="analyzeImport()"
                      :disabled="!file || loading"
                      :class="(!file || loading) ? 'opacity-50 cursor-not-allowed' : ''"
                      class="px-3 py-1.5 border border-transparent rounded-md text-sm font-medium text-white focus:outline-none"
                      style="background-color: var(--content-type-color);">
                Preview Import
              </button>
              <button type="button"
                      x-show="analysis"
                      @click="performImport()"
                      :disabled="loading || isNoop()"
                      :class="(loading || isNoop()) ? 'opacity-50 cursor-not-allowed' : ''"
                      class="px-3 py-1.5 border border-transparent rounded-md text-sm font-medium text-white focus:outline-none"
                      :style="analysis?.filled_answers_at_risk > 0 ? 'background-color: #dc2626;' : 'background-color: var(--content-type-color);'">
                <span x-text="analysis?.filled_answers_at_risk > 0 ? 'Import & Delete Answers' : 'Apply Import'"></span>
              </button>
            </div>
          </div>
        </div>
        
        <div class="border border-red-200 dark:border-red-800 rounded-lg overflow-hidden"  
             x-data="templateResetComponent()"
             id="reset-template-component">
          <button @click="toggleReset()" 
                  class="w-full flex items-center justify-between p-3 hover:bg-red-50 dark:hover:bg-red-900 transition-colors text-left">
            <div class="flex items-center">
              <i class="material-icons text-red-600 mr-3">restore</i>
              <div>
                <div class="font-medium text-red-900 dark:text-red-300">Reset Template</div>
                <div class="text-sm text-red-600 dark:text-red-400">Delete all customizations and start fresh</div>
              </div>
            </div>
            <i class="material-icons text-red-400 transition-transform" 
               :class="{ 'rotate-180': resetOpen }">expand_more</i>
          </button>
          
          <div x-show="resetOpen" 
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0 transform scale-95"
               x-transition:enter-end="opacity-100 transform scale-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100 transform scale-100"
               x-transition:leave-end="opacity-0 transform scale-95"
               class="border-t border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900 p-4">
            
            <!-- Loading State -->
            <div x-show="loading" class="text-center py-4">
              <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-red-600 dark:border-red-400 mx-auto mb-2"></div>
              <p class="text-sm text-red-700 dark:text-red-300">Analyzing template...</p>
            </div>
            
            <!-- Reset Analysis -->
            <div x-show="!loading && resetAnalysis && !resetConfirm" class="space-y-4">
              <div class="bg-white dark:bg-slate-800 rounded-md p-3 border border-red-200 dark:border-red-700">
                <h4 class="font-medium text-red-900 dark:text-red-200 mb-2 flex items-center">
                  <i class="material-icons text-red-600 dark:text-red-400 mr-2">warning</i>
                  Reset Impact Analysis
                </h4>
                <div class="text-sm text-red-700 dark:text-red-300 space-y-1">
                  <p><strong x-text="resetAnalysis?.total_categories || 0"></strong> categories and <strong x-text="resetAnalysis?.total_fields || 0"></strong> fields will be deleted</p>
                  <p x-show="resetAnalysis?.custom_categories?.length > 0"><strong x-text="resetAnalysis?.custom_categories?.length || 0"></strong> custom categories you created</p>
                  <p x-show="resetAnalysis?.data_loss_warnings?.length > 0" class="text-red-800 dark:text-red-300 font-medium">
                    <strong x-text="resetAnalysis?.data_loss_warnings?.length || 0"></strong> fields have data that will be permanently lost!
                  </p>
                  <p x-show="resetAnalysis?.filled_attributes_count > 0" class="text-red-900 dark:text-red-200 font-bold">
                    <strong x-text="resetAnalysis?.filled_attributes_count || 0"></strong> filled answers will be deleted across <strong x-text="resetAnalysis?.affected_pages_count || 0"></strong> different pages
                  </p>
                </div>
              </div>
              
              <!-- Data Loss Warnings -->
              <div x-show="resetAnalysis?.data_loss_warnings?.length > 0" class="bg-red-100 dark:bg-slate-800 rounded-md p-3 border border-red-300 dark:border-red-700">
                <h5 class="font-medium text-red-900 dark:text-red-100 mb-2">⚠️ Data Loss Warning</h5>
                <div class="text-sm text-red-800 dark:text-red-200 space-y-1 max-h-32 overflow-y-auto">
                  <template x-for="warning in (resetAnalysis?.data_loss_warnings || [])" :key="warning.category + warning.field">
                    <p><strong x-text="warning.category"></strong> → <span x-text="warning.field"></span> (<span x-text="warning.filled_count"></span> filled answers)</p>
                  </template>
                </div>
              </div>
              
              <div class="flex justify-end space-x-2">
                <button @click="resetOpen = false" 
                        class="px-3 py-1.5 border border-gray-300 dark:border-slate-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-700 hover:bg-gray-50 dark:hover:bg-slate-600">
                  Cancel
                </button>
                <button @click="resetConfirm = true" 
                        class="px-3 py-1.5 bg-red-600 border border-red-600 rounded-md text-sm font-medium text-white hover:bg-red-700">
                  I Understand, Continue
                </button>
              </div>
            </div>
            
            <!-- Final Confirmation -->
            <div x-show="resetConfirm" class="space-y-4">
              <div class="bg-red-100 dark:bg-slate-800 rounded-md p-3 border border-red-300 dark:border-red-700">
                <h4 class="font-medium text-red-900 dark:text-red-100 mb-2">⚠️ Final Confirmation Required</h4>
                <p class="text-sm text-red-800 dark:text-red-200 mb-3">
                  Type "<strong><%= content_type.titleize %></strong>" below to confirm you want to permanently reset this template:
                </p>
                <input type="text" 
                       x-model="confirmText"
                       placeholder="<%= content_type.titleize %>"
                       class="w-full px-3 py-2 border border-red-300 dark:border-red-700 dark:bg-slate-900 dark:text-red-100 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
              </div>
              
              <div class="flex justify-end space-x-2">
                <button @click="resetConfirm = false" 
                        class="px-3 py-1.5 border border-gray-300 dark:border-slate-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-700 hover:bg-gray-50 dark:hover:bg-slate-600">
                  Cancel
                </button>
                <button @click="performReset()" 
                        :disabled="confirmText !== '<%= content_type.titleize %>'"
                        :class="confirmText === '<%= content_type.titleize %>' ? 'bg-red-600 hover:bg-red-700 text-white' : 'bg-gray-300 text-gray-500 cursor-not-allowed'"
                        class="px-3 py-1.5 border border-transparent rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-red-500">
                  <i class="material-icons text-sm mr-1">delete_forever</i>
                  Reset Template Permanently
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>


    <!-- Archive Management -->
    <div x-data="{ showArchived: true, archivedItemsCount: 0 }" x-init="updateArchivedItemsCount()">
      <h3 class="font-medium text-gray-900 dark:text-gray-100 mb-3">Editor Settings</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="font-medium text-gray-900 dark:text-gray-100">Show archived items</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">
              <span x-show="archivedItemsCount > 0" 
                    x-text="`(${archivedItemsCount} archived)`" 
                    class="text-xs text-gray-400"></span>
            </div>
          </div>
          <div class="toggle-switch relative inline-flex items-center h-6 w-11 bg-gray-200 dark:bg-slate-700 rounded-full cursor-pointer transition-colors duration-200 ease-in-out">
            <input type="checkbox" 
                   x-model="showArchived" 
                   @change="toggleArchivedItems($event.target.checked)"
                   class="sr-only">
            <span class="toggle-dot absolute left-0 inline-block h-5 w-5 bg-white rounded-full shadow transform transition-transform duration-200 ease-in-out translate-x-0"></span>
          </div>
        </div>
        <div x-show="archivedItemsCount === 0" class="text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-slate-700 p-2 rounded-md">
          <i class="material-icons text-xs mr-1">info</i>
          No archived items. Archive categories or fields to organize your workspace.
        </div>
      </div>
    </div>

    <!-- Help Section -->
    <div class="bg-blue-50 dark:bg-slate-700 rounded-lg p-4">
      <h3 class="font-medium text-blue-900 dark:text-blue-100 mb-2 flex items-center">
        <i class="material-icons text-blue-600 dark:text-blue-400 mr-2">help_outline</i>
        Need Help?
      </h3>
      <p class="text-sm text-blue-700 dark:text-gray-300 mb-3">
        Learn more about customizing your templates and organizing your content.
      </p>
      <%= link_to help_page_templates_path, class: "text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-500 dark:hover:text-blue-300 flex items-center", target: "_blank" do %>
        View Documentation
        <i class="material-icons text-sm ml-1">open_in_new</i>
      <% end %>
    </div>
  </div>
</div>