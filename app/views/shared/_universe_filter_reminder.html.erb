  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-700 rounded-lg p-6 flex flex-col sm:flex-row items-center justify-between shadow-sm border border-blue-100 dark:border-slate-600">
    <div class="flex items-center mb-4 sm:mb-0">
      <div class="flex-shrink-0 mr-4">
        <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-slate-600 flex items-center justify-center">
          <i class="material-icons text-blue-500 dark:text-blue-300 text-2xl">filter_list</i>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-white">Universe Filter Active</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
          You are currently only seeing <%= content_type_name.to_s.pluralize.downcase %> in 
          <strong><%= @universe_scope.name %></strong>.
        </p>
      </div>
    </div>
    <div class="flex-shrink-0">
      <%= link_to url_for(params.permit(:sort, :slug, :favorite_only).to_h.merge(universe: 'all')), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white #{content_type_name.constantize.color} hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-slate-800 transition-colors" do %>
        <i class="material-icons text-sm mr-2">public</i>
        See all <%= content_type_name.to_s.pluralize.downcase %>
      <% end %>
    </div>
  </div>
