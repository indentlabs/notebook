<% content_for :title, "Privacy & Sharing - Notebook.ai Help" %>

<% section_link = "block text-sm text-gray-600 dark:text-gray-300 hover:text-teal-600 dark:hover:text-teal-400 transition-colors duration-200" %>

<!-- Hero Header -->
<div class="bg-gradient-to-r from-teal-600 to-blue-600 dark:from-teal-800 dark:to-blue-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center mb-6">
      <%= link_to main_app.help_center_path, class: "inline-flex items-center text-teal-100 hover:text-white transition-colors duration-200" do %>
        <i class="material-icons mr-2">arrow_back</i>
        Back to Help Center
      <% end %>
    </div>

    <div class="flex items-center mb-4">
      <div class="bg-white bg-opacity-20 rounded-full p-3 mr-4">
        <i class="material-icons text-3xl">security</i>
      </div>
      <div>
        <h1 class="text-4xl font-bold mb-2">Privacy &amp; Sharing</h1>
        <p class="text-xl text-teal-100">Who can see your worldbuilding and writing, and how to change it</p>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col lg:flex-row gap-8">

    <!-- Sticky Table of Contents -->
    <div class="lg:w-1/4">
      <div class="sticky top-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 p-6">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Table of Contents</h3>
          <nav class="space-y-2">
            <a href="#privacy-settings" class="<%= section_link %>">The Three Privacy Settings</a>
            <a href="#changing-privacy" class="<%= section_link %>">Changing a Page's Privacy</a>
            <a href="#universes-and-books" class="<%= section_link %>">Universes &amp; Books</a>
            <a href="#password-protection" class="<%= section_link %>">Password Protection</a>
            <a href="#collaborators" class="<%= section_link %>">Collaborators</a>
            <a href="#where-public-content-appears" class="<%= section_link %>">Where Public Content Appears</a>
            <a href="#automatic-publishing" class="<%= section_link %>">Actions That Make Pages Public</a>
            <a href="#images" class="<%= section_link %>">Images</a>
            <a href="#private-notes" class="<%= section_link %>">Private Notes</a>
            <a href="#profile" class="<%= section_link %>">Your Profile</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="lg:w-3/4">
      <div class="prose prose-lg max-w-none">

        <!-- The Three Privacy Settings -->
        <section id="privacy-settings" class="mb-12">
          <div class="bg-teal-50 dark:bg-gray-700 border-l-4 border-teal-400 dark:border-teal-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-teal-900 dark:text-teal-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-teal-600 dark:text-teal-400">tune</i>
              The Three Privacy Settings
            </h2>
            <p class="text-teal-800 dark:text-teal-200 leading-relaxed">
              Every universe, worldbuilding page (characters, locations, items and the rest) and document has one of three privacy settings.
              Everything is <strong>private by default</strong>, so nothing is shared until you choose to share it.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5">
              <div class="flex items-center mb-2">
                <i class="material-icons text-gray-600 dark:text-gray-300 mr-2">lock</i>
                <h3 class="font-semibold text-gray-900 dark:text-white">Private</h3>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-300">
                Only you and the collaborators on its universe can see it. Everyone else is turned away.
              </p>
            </div>
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5">
              <div class="flex items-center mb-2">
                <i class="material-icons text-green-600 dark:text-green-400 mr-2">public</i>
                <h3 class="font-semibold text-gray-900 dark:text-white">Public</h3>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-300">
                Anyone can view it, with or without an account, and it can appear on your profile, in your universe's lists and in search engines.
              </p>
            </div>
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5">
              <div class="flex items-center mb-2">
                <i class="material-icons text-teal-600 dark:text-teal-400 mr-2">vpn_key</i>
                <h3 class="font-semibold text-gray-900 dark:text-white">Password protected</h3>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-300">
                Anyone with the link and the password can view it. It stays out of every list, search and feed on the site.
                <a href="#password-protection" class="text-teal-600 dark:text-teal-400 hover:underline">More below</a>.
              </p>
            </div>
          </div>
        </section>

        <!-- Changing a Page's Privacy -->
        <section id="changing-privacy" class="mb-12">
          <div class="bg-blue-50 dark:bg-gray-700 border-l-4 border-blue-400 dark:border-blue-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-blue-900 dark:text-blue-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-blue-600 dark:text-blue-400">edit</i>
              Changing a Page's Privacy
            </h2>
          </div>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Universes and worldbuilding pages</h3>
          <ol class="list-decimal list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>Open the page and click <strong>Edit</strong></li>
            <li>Choose <strong>Privacy &amp; Sharing</strong> in the left-hand menu</li>
            <li>Pick <strong>Private</strong>, <strong>Public</strong> or <strong>Password protected</strong>. Private and public save straight away.</li>
          </ol>
          <p class="text-gray-700 dark:text-gray-300 mb-6">
            The panel also shows the page's <strong>effective visibility</strong>, which can differ from its own setting when its universe is public.
            Once other people can open the page, it shows the link to send them.
          </p>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Documents</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-6">
            Click the privacy button on a document (the lock, globe or key icon) to open its privacy settings. Documents have the same three settings as pages.
            Books and timelines have their own privacy settings too: public or private.
          </p>
        </section>

        <!-- Universes & Books -->
        <section id="universes-and-books" class="mb-12">
          <div class="bg-purple-50 dark:bg-gray-700 border-l-4 border-purple-400 dark:border-purple-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-purple-900 dark:text-purple-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-purple-600 dark:text-purple-400">account_tree</i>
              Universes &amp; Books
            </h2>
            <p class="text-purple-800 dark:text-purple-200 leading-relaxed">
              A public universe or book shares what's inside it, so you don't have to make every page public one by one.
            </p>
          </div>

          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li><strong>A public universe</strong> makes everything in it visible to everyone: pages, documents, books and timelines, even the ones set to private.</li>
            <li><strong>A public book</strong> makes its chapters readable to anyone who can view the book, even chapters that are set to private.</li>
            <li><strong>Password protection always wins.</strong> A password protected page or document stays protected inside a public universe or book.</li>
            <li><strong>A private or password protected universe passes nothing on.</strong> Everything in it follows its own setting.</li>
          </ul>

          <div class="bg-amber-50 dark:bg-gray-700 border border-amber-200 dark:border-amber-700 rounded-lg p-4 mb-6">
            <h4 class="font-semibold text-amber-900 dark:text-amber-100 mb-2 flex items-center">
              <i class="material-icons mr-2 text-amber-600 dark:text-amber-400">visibility</i>
              Before you make a universe public
            </h4>
            <p class="text-amber-800 dark:text-amber-200 text-sm">
              Every private page in it becomes visible. Protect anything you want to keep to yourself or your group with a password first, or move it to another universe.
            </p>
          </div>
        </section>

        <!-- Password Protection -->
        <section id="password-protection" class="mb-12">
          <div class="bg-teal-50 dark:bg-gray-700 border-l-4 border-teal-400 dark:border-teal-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-teal-900 dark:text-teal-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-teal-600 dark:text-teal-400">vpn_key</i>
              Password Protection
            </h2>
            <p class="text-teal-800 dark:text-teal-200 leading-relaxed">
              Share a page or document with just a few people, like your players or beta readers, without making it public.
            </p>
          </div>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Setting a password</h3>
          <ol class="list-decimal list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>Choose <strong>Password protected</strong> in its privacy settings</li>
            <li>Pick a password of at least 5 characters and click <strong>Save password</strong></li>
            <li>Copy the link shown under <strong>Link to share</strong>, and send it and the password to the people you want to see it. It's best to send the password separately.</li>
          </ol>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">What your readers see</h3>
          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>A lock screen showing only what kind of page it is and who made it, never its name or contents</li>
            <li>Once they enter the password, the page or document itself, for as long as their browser session lasts or until they sign out</li>
            <li>Nothing else: the password doesn't let them edit, share, or open anything linked from the page that isn't already visible to them</li>
          </ul>

          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Good to know</h3>
          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>You and your universe's collaborators can always view it without the password</li>
            <li>Only the owner can set, change or remove the password</li>
            <li><strong>Changing the password</strong> locks out everyone who entered the old one</li>
            <li>Protected pages stay out of search engines and out of your profile, universe lists, tag pages and the community stream</li>
            <li>Protected pages can't be shared to the community stream or submitted to collections</li>
            <li>To stop people from guessing, there's a limit on how many passwords someone can try in a minute</li>
          </ul>

          <div class="bg-blue-50 dark:bg-gray-700 border border-blue-200 dark:border-blue-700 rounded-lg p-4 mb-6">
            <h4 class="font-semibold text-blue-900 dark:text-blue-100 mb-2 flex items-center">
              <i class="material-icons mr-2 text-blue-600 dark:text-blue-400">language</i>
              Password protecting a universe
            </h4>
            <p class="text-blue-800 dark:text-blue-200 text-sm">
              A universe's password opens the universe's own page, and nothing else. The pages in it follow their own privacy settings, just as they would in a private universe:
              public pages stay public, private pages stay private, and protected pages need their own password.
            </p>
          </div>
        </section>

        <!-- Collaborators -->
        <section id="collaborators" class="mb-12">
          <div class="bg-indigo-50 dark:bg-gray-700 border-l-4 border-indigo-400 dark:border-indigo-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-indigo-900 dark:text-indigo-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-indigo-600 dark:text-indigo-400">group</i>
              Collaborators
            </h2>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-4">
            People you've invited to a universe (see <%= link_to 'Collaboration Features', help_organizing_with_universes_path(anchor: 'collaboration'), class: 'text-indigo-600 dark:text-indigo-400 hover:underline' %>) can:
          </p>
          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>See everything in the universe, including private and password protected pages, without a password</li>
            <li>Edit its pages, and switch a page between private and public</li>
            <li>Not set, change or remove a password. Only the page's owner can.</li>
          </ul>
        </section>

        <!-- Where Public Content Appears -->
        <section id="where-public-content-appears" class="mb-12">
          <div class="bg-green-50 dark:bg-gray-700 border-l-4 border-green-400 dark:border-green-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-green-900 dark:text-green-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-green-600 dark:text-green-400">travel_explore</i>
              Where Public Content Appears
            </h2>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-4">A public page, including one that's public because its universe is, can show up:</p>
          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>On your public profile, and in its lists of your pages</li>
            <li>In its universe's lists and table of contents</li>
            <li>In search engines</li>
            <li>In the community stream and in collections, if you share it or submit it</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Tag pages are stricter: they only list pages that are set to public themselves, not ones that are public because of their universe.
          </p>
          <p class="text-gray-700 dark:text-gray-300 mb-6">
            Private and password protected pages appear in none of these places. Where another page links to one, visitors who can't open it see "Private character" (or location, and so on) instead of its name.
          </p>
        </section>

        <!-- Actions That Make Pages Public -->
        <section id="automatic-publishing" class="mb-12">
          <div class="bg-amber-50 dark:bg-gray-700 border-l-4 border-amber-400 dark:border-amber-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-amber-900 dark:text-amber-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-amber-600 dark:text-amber-400">campaign</i>
              Actions That Make Pages Public
            </h2>
            <p class="text-amber-800 dark:text-amber-200 leading-relaxed">
              A couple of ways of sharing a page change its privacy to public for you, since nobody could see it otherwise.
            </p>
          </div>

          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li><strong>Sharing your page to the community stream</strong> makes it public</li>
            <li><strong>Submitting your page to a public collection</strong> makes it public</li>
            <li>Other people can only share or submit pages that are already public</li>
            <li>Password protected pages can't be shared or submitted at all, so they're never made public this way</li>
          </ul>
          <p class="text-gray-700 dark:text-gray-300 mb-6">
            You can make a page private again whenever you like, but anyone who saw it while it was public may already have read or saved it.
          </p>
        </section>

        <!-- Images -->
        <section id="images" class="mb-12">
          <div class="bg-pink-50 dark:bg-gray-700 border-l-4 border-pink-400 dark:border-pink-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-pink-900 dark:text-pink-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-pink-600 dark:text-pink-400">photo_library</i>
              Images
            </h2>
          </div>

          <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-6 ml-4">
            <li>Each image in a page's gallery has its own privacy setting. New uploads are public unless you choose otherwise.</li>
            <li>Private images are only shown to people who can edit the page: you and your universe's collaborators</li>
            <li>Public images are shown to anyone who can view the page, including readers who entered its password</li>
            <li>Images you've saved from Basil are shown to anyone who can view the page</li>
          </ul>
        </section>

        <!-- Private Notes -->
        <section id="private-notes" class="mb-12">
          <div class="bg-gray-50 dark:bg-gray-700 border-l-4 border-gray-400 dark:border-gray-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-gray-600 dark:text-gray-400">sticky_note_2</i>
              Private Notes
            </h2>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-6">
            Every worldbuilding page has a <strong>Private Notes</strong> field. What you write there is only ever shown to you, even when the page is public or shared.
            It's a good place for spoilers, secrets and reminders.
          </p>
        </section>

        <!-- Your Profile -->
        <section id="profile" class="mb-12">
          <div class="bg-gray-50 dark:bg-gray-700 border-l-4 border-gray-400 dark:border-gray-500 p-6 rounded-r-lg mb-6">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center">
              <i class="material-icons mr-3 text-gray-600 dark:text-gray-400">account_circle</i>
              Your Profile
            </h2>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Your profile shows your public pages and universes. To hide it, turn on <strong>Private profile</strong> in your account's preferences.
            See <%= link_to 'Managing Your Account', help_your_account_path, class: 'text-gray-900 dark:text-white underline' %> for more.
          </p>
          <p class="text-gray-700 dark:text-gray-300 mb-6">
            A private profile only hides the profile page itself. Public pages are still public, so make them private or password protect them to hide them too.
          </p>
        </section>

        <!-- Still need help -->
        <section class="mb-12">
          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Something not working as expected?</h3>
            <p class="text-gray-700 dark:text-gray-300 text-sm">
              Check <%= link_to 'Troubleshooting & FAQ', help_troubleshooting_path(anchor: 'privacy'), class: 'text-teal-600 dark:text-teal-400 hover:underline' %> for common privacy questions.
            </p>
          </div>
        </section>

      </div>
    </div>
  </div>
</div>
