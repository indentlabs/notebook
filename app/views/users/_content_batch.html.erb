      <!-- Content Grid -->
      <div id="content-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @content_list.each do |content| %>
          <div class="content-card group">
            
            <!-- Card Container -->
            <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300 dark:bg-gray-800 dark:border-gray-700">
              
              <% if user_signed_in? && current_user.can_read?(content) %>
                <%= link_to (content.is_a?(ContentPage) ? content.view_path : content),
                    class: "content-card-link absolute inset-0 z-10 rounded-xl",
                    aria: { label: "View #{content.name.presence || 'Untitled'}" } do %>
                <% end %>
              <% end %>

              <!-- Card Image -->
              <div class="relative h-48 overflow-hidden">
                <%= content_image_tag content, :card, pick: :random, class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300', loading: 'lazy' %>
                
                <!-- Content Title -->
                <div class="absolute bottom-4 left-4 right-4">
                  <h3 class="text-white font-bold text-lg line-clamp-2 mb-2">
                    <%= content.name.presence || 'Untitled' %>
                  </h3>
                  
                  <!-- Favorite badge if favorited -->
                  <% if content.respond_to?(:favorite) && content.favorite %>
                    <div class="inline-flex items-center px-2 py-1 bg-yellow-100 rounded-full">
                      <i class="material-icons text-yellow-600 text-sm">star</i>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <!-- Card Content -->
              <div class="p-4">
                
                <!-- Description -->
                <% if content.description.present? %>
                  <p class="text-gray-600 text-sm line-clamp-3 mb-3 dark:text-gray-300">
                    <%= sanitize ContentFormatterService.show(text: truncate(content.description, length: 120, escape: false), viewing_user: current_user) %>
                  </p>
                <% end %>
                
                <!-- Tags -->
                <% if content.respond_to?(:page_tags) && content.page_tags.any? %>
                  <div class="flex flex-wrap gap-1 mb-3">
                    <% content.page_tags.first(3).each do |tag| %>
                      <%= link_to user_tag_path_for(content.user, tag.slug), class: "relative z-20 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600" do %>
                        <%= tag.tag %>
                      <% end %>
                    <% end %>
                    <% if content.page_tags.size > 3 %>
                      <span class="text-xs text-gray-400">+<%= content.page_tags.size - 3 %> more</span>
                    <% end %>
                  </div>
                <% end %>
                
                <!-- Footer -->
                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                  <span class="flex items-center">
                    <i class="material-icons text-xs mr-1">schedule</i>
                    <%= content.created_at == content.updated_at ? 'Created' : 'Updated' %>
                    <%= time_ago_in_words(content.updated_at) %> ago
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Content List View (Hidden by default) -->
      <div id="content-list" class="hidden space-y-4">
        <% @content_list.each do |content| %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow duration-200 dark:bg-gray-800 dark:border-gray-700">
            <div class="flex items-start space-x-4">
              
              <!-- Thumbnail -->
              <div class="flex-shrink-0">
                <%= content_image_tag content, :square, pick: :random, size: :small, class: 'w-16 h-16 rounded-lg object-cover', loading: 'lazy' %>
              </div>
              
              <!-- Content Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900 mb-1 dark:text-white">
                      <%= content.name.presence || 'Untitled' %>
                    </h3>
                    
                    <% if content.description.present? %>
                      <p class="text-gray-600 text-sm line-clamp-2 mb-2 dark:text-gray-300">
                        <%= sanitize ContentFormatterService.show(text: truncate(content.description, length: 200, escape: false), viewing_user: current_user) %>
                      </p>
                    <% end %>
                    
                    <!-- Tags -->
                    <% if content.respond_to?(:page_tags) && content.page_tags.any? %>
                      <div class="flex flex-wrap gap-1 mb-2">
                        <% content.page_tags.first(5).each do |tag| %>
                          <%= link_to user_tag_path_for(content.user, tag.slug), class: "inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600" do %>
                            <%= tag.tag %>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                    
                    <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                      <i class="material-icons text-xs mr-1">schedule</i>
                      <%= content.created_at == content.updated_at ? 'Created' : 'Updated' %>
                      <%= time_ago_in_words(content.updated_at) %> ago
                    </div>
                  </div>
                  
                  <!-- Actions -->
                  <div class="flex items-center space-x-2 ml-4">
                    <% if content.respond_to?(:favorite) && content.favorite %>
                      <div class="p-2 bg-yellow-100 rounded-lg">
                        <i class="material-icons text-yellow-600 text-sm">star</i>
                      </div>
                    <% end %>
                    
                    <% if user_signed_in? && current_user.can_read?(content) %>
                      <%= link_to (content.is_a?(ContentPage) ? content.view_path : content), class: "inline-flex items-center px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors duration-200" do %>
                        <i class="material-icons mr-1 text-sm">visibility</i>
                        View
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
