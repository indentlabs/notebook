<!-- Main Container -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  
  <!-- Hero Section -->
  <div class="relative bg-gradient-to-br from-indigo-600 via-blue-600 to-purple-700 text-white overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="%23ffffff" fill-opacity="0.1" fill-rule="evenodd"%3E%3Cpath d="M20 20c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8 8 3.6 8 8zm0-20c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8 8 3.6 8 8z"/%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <!-- Hero Image Background -->
    <div class="absolute inset-0 opacity-20">
      <%= image_tag "card-headers/#{@content_type.to_s.downcase.pluralize}.webp", class: "w-full h-full object-cover" %>
    </div>
    
    <!-- Content -->
    <div class="relative px-6 py-12">
      <div class="max-w-7xl mx-auto">
        
        <!-- Breadcrumb -->
        <nav class="mb-8">
          <div class="flex items-center space-x-2 text-white text-opacity-80 text-sm">
            <%= link_to "Users", users_path, class: "hover:text-white transition-colors duration-200" %>
            <i class="material-icons text-xs">chevron_right</i>
            <%= link_to @user.display_name, (@user.username.present? ? profile_by_username_path(username: @user.username) : user_path(@user)), class: "hover:text-white transition-colors duration-200" %>
            <i class="material-icons text-xs">chevron_right</i>
            <span class="text-white font-medium"><%= @content_type.to_s.capitalize.pluralize %></span>
          </div>
        </nav>
        
        <!-- Main Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
          
          <!-- Left: User & Content Type Info -->
          <div class="flex items-center space-x-6 mb-6 lg:mb-0">
            
            <!-- User Avatar -->
            <div class="flex-shrink-0">
              <%= link_to (@user.username.present? ? profile_by_username_path(username: @user.username) : user_path(@user)), class: "group" do %>
                <div class="relative">
                  <% if @user.image_url.present? %>
                    <%= image_tag @user.image_url, class: "w-20 h-20 rounded-full border-4 border-white border-opacity-30 group-hover:border-opacity-50 transition-all duration-300" %>
                  <% else %>
                    <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full border-4 border-white border-opacity-30 group-hover:border-opacity-50 transition-all duration-300 flex items-center justify-center">
                      <i class="material-icons text-white text-3xl">person</i>
                    </div>
                  <% end %>
                  
                  <!-- Online indicator if applicable -->
                  <% if @user.respond_to?(:online?) && @user.online? %>
                    <div class="absolute bottom-1 right-1 w-5 h-5 bg-green-400 rounded-full border-2 border-white"></div>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <!-- User & Content Type Info -->
            <div>
              <div class="flex items-center space-x-3 mb-2">
                <%= link_to (@user.username.present? ? profile_by_username_path(username: @user.username) : user_path(@user)), class: "hover:underline" do %>
                  <h1 class="text-2xl font-bold text-white"><%= @user.display_name %></h1>
                <% end %>
                <% if @user.username.present? %>
                  <span class="text-white text-opacity-70 text-lg">@<%= @user.username %></span>
                <% end %>
              </div>
              
              <!-- Content Type Display -->
              <div class="flex items-center space-x-3">
                <div class="inline-flex items-center px-4 py-2 bg-white bg-opacity-20 backdrop-blur-sm rounded-full">
                  <i class="material-icons mr-2 text-white"><%= @content_type.icon %></i>
                  <span class="text-white font-semibold text-lg"><%= @content_type.to_s.capitalize.pluralize %></span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Right: Stats & Actions -->
          <div class="flex flex-wrap gap-4">
            <% if @content_list.any? %>
              <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-4 py-3 text-center">
                <div class="text-2xl font-bold text-white"><%= @content_list.total_entries %></div>
                <div class="text-white text-opacity-80 text-sm"><%= @content_type.to_s.capitalize.pluralize %></div>
              </div>

              <div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg px-4 py-3 text-center">
                <div class="text-2xl font-bold text-white"><%= @content_list.sum(&:cached_word_count) rescue 0 %></div>
                <div class="text-white text-opacity-80 text-sm">Words</div>
              </div>
            <% end %>
            
            <%= link_to (@user.username.present? ? profile_by_username_path(username: @user.username) : user_path(@user)), class: "bg-white bg-opacity-20 backdrop-blur-sm hover:bg-opacity-30 transition-colors duration-200 rounded-lg px-4 py-3 flex items-center space-x-2" do %>
              <i class="material-icons text-white">person</i>
              <span class="text-white font-medium">View Profile</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Content Section -->
  <div class="max-w-7xl mx-auto px-6 py-8">
    
    <% if @content_list.empty? %>
      
      <!-- Empty State -->
      <div class="text-center py-16">
        <div class="mx-auto w-24 h-24 <%= @content_type.color %> bg-opacity-10 rounded-full flex items-center justify-center mb-6">
          <i class="material-icons text-4xl <%= @content_type.text_color %>"><%= @content_type.icon %></i>
        </div>
        
        <h2 class="text-2xl font-bold text-gray-900 mb-2 dark:text-white">No <%= @content_type.to_s.capitalize.pluralize %> Found</h2>
        <p class="text-gray-600 max-w-md mx-auto mb-6 dark:text-gray-300">
          <%= @user.display_name %> hasn't made any <%= @content_type.name.downcase.pluralize %> public yet, or they may not have any to share.
        </p>
        
        <div class="space-y-4">
          <p class="text-gray-500 text-sm max-w-lg mx-auto">
            <%= t("content_descriptions.#{@content_type.name.downcase}") %>
          </p>
          
          <%= link_to (@user.username.present? ? profile_by_username_path(username: @user.username) : user_path(@user)), class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200" do %>
            <i class="material-icons mr-2 text-sm">arrow_back</i>
            Back to Profile
          <% end %>
        </div>
      </div>
      
    <% else %>
      
      <!-- Content Actions Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2 dark:text-white">
            <%= pluralize(@content_list.total_entries, @content_type.name) %>
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Public <%= @content_type.name.downcase.pluralize %> by <%= @user.display_name %>
          </p>
        </div>
        
        <!-- View Options -->
        <div class="flex items-center space-x-2 mt-4 sm:mt-0">
          <button id="grid-view" class="view-toggle active p-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors duration-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600">
            <i class="material-icons">grid_view</i>
          </button>
          <button id="list-view" class="view-toggle p-2 rounded-lg bg-white border border-gray-300 text-gray-600 hover:bg-gray-50 transition-colors duration-200 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
            <i class="material-icons">view_list</i>
          </button>
        </div>
      </div>
      
      <%= render 'users/content_batch' %>

      <% if @content_list.next_page %>
        <div id="content-loader" class="mt-8 text-center">
          <%= link_to 'Load more', url_for(page: @content_list.next_page),
              id: 'content-load-more', class: 'inline-block px-6 py-3 rounded-lg bg-blue-600 text-white' %>
          <p id="content-load-status" role="status" aria-live="polite" class="mt-2 text-sm text-gray-600 dark:text-gray-400"></p>
        </div>
      <% end %>
      
    <% end %>
  </div>
</div>

<!-- Custom Styles -->
<style>
.content-card-link:focus-visible {
  outline: 3px solid rgb(59 130 246);
  outline-offset: -3px;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.view-toggle.active {
  background-color: rgb(59 130 246);
  color: white;
}
</style>

<!-- View Toggle JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const gridViewBtn = document.getElementById('grid-view');
  const listViewBtn = document.getElementById('list-view');
  const contentGrid = document.getElementById('content-grid');
  const contentList = document.getElementById('content-list');
  
  if (gridViewBtn && listViewBtn && contentGrid && contentList) {
    gridViewBtn.addEventListener('click', function() {
      // Show grid, hide list
      contentGrid.classList.remove('hidden');
      contentList.classList.add('hidden');
      
      // Update button states
      gridViewBtn.classList.add('active');
      listViewBtn.classList.remove('active');
    });
    
    listViewBtn.addEventListener('click', function() {
      // Show list, hide grid
      contentList.classList.remove('hidden');
      contentGrid.classList.add('hidden');
      
      // Update button states
      listViewBtn.classList.add('active');
      gridViewBtn.classList.remove('active');
    });
  }

  const loader = document.getElementById('content-loader');
  const loadMore = document.getElementById('content-load-more');
  const status = document.getElementById('content-load-status');
  if (!loader || !loadMore || !window.fetch || !window.IntersectionObserver || !window.AbortController) return;

  let nextUrl = loadMore.href;
  let busy = false;
  let stopped = false;
  let cooldown;
  let request;
  const observer = new IntersectionObserver(entries => {
    if (entries.some(entry => entry.isIntersecting) && !document.hidden) loadNextBatch();
  }, { rootMargin: '200px' });

  async function loadNextBatch() {
    if (busy || stopped || !nextUrl) return;
    busy = true;
    observer.disconnect();
    loadMore.setAttribute('aria-disabled', 'true');
    status.textContent = 'Loading more…';
    request = new AbortController();
    const timeout = setTimeout(() => request.abort(), 15000);
    let succeeded = false;

    try {
      const response = await fetch(nextUrl, {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
        signal: request.signal
      });
      if (!response.ok || response.redirected) throw new Error('Unable to load content');
      const batch = await response.json();
      const fragment = new DOMParser().parseFromString(batch.html, 'text/html');
      const grid = fragment.getElementById('content-grid');
      const list = fragment.getElementById('content-list');
      if (!grid || !list) throw new Error('Invalid content');
      if (stopped) return;
      contentGrid.append(...grid.children);
      contentList.append(...list.children);
      nextUrl = batch.next_url;
      succeeded = true;
      status.textContent = nextUrl ? '' : 'All content loaded.';
      if (nextUrl) {
        loadMore.href = nextUrl;
      } else {
        loadMore.hidden = true;
      }
    } catch (error) {
      if (!stopped) {
        status.textContent = 'Could not load more. Select Retry to try again.';
        loadMore.textContent = 'Retry';
      }
    } finally {
      clearTimeout(timeout);
      // Pace requests even if the sentinel stays visible on a large screen.
      cooldown = setTimeout(() => {
        busy = false;
        loadMore.removeAttribute('aria-disabled');
        if (succeeded && nextUrl && !stopped) {
          loadMore.textContent = 'Load more';
          observer.observe(loader);
        }
      }, 1000);
    }
  }

  loadMore.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    loadNextBatch();
  });
  observer.observe(loader);
  window.addEventListener('pagehide', () => {
    stopped = true;
    observer.disconnect();
    clearTimeout(cooldown);
    if (request) request.abort();
  });
  window.addEventListener('pageshow', event => {
    if (event.persisted) {
      stopped = false;
      busy = false;
      loadMore.removeAttribute('aria-disabled');
      if (nextUrl) observer.observe(loader);
    }
  });

});
</script>