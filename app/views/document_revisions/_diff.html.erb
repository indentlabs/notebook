<%# What changed between two versions. Locals: diff (a RevisionDiff) %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 dark:bg-gray-800 dark:border-gray-700">
  <div class="mb-6 pb-4 border-b border-gray-200 dark:border-gray-700">
    <h3 class="text-lg font-semibold text-gray-900 mb-3 dark:text-white">Changes Summary</h3>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <div class="flex items-center">
        <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
        <span class="text-gray-600 dark:text-gray-400">
          <span class="font-semibold text-gray-900 dark:text-white"><%= diff.word_change > 0 ? '+' : '' %><%= diff.word_change %></span> words
        </span>
      </div>
      <div class="text-gray-500 dark:text-gray-400">
        Previous: <%= diff.previous_words %> words → This version: <%= diff.current_words %> words
      </div>
      <% if diff.truncated? %>
        <div class="text-amber-600 flex items-center">
          <i class="material-icons text-xs mr-1">warning</i>Too many changes to show them all; showing the first ones
        </div>
      <% end %>
    </div>
  </div>

  <% if diff.text_changed? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <% [['Previous Version', 'history', 'text-gray-400', 'bg-gray-50', diff.old_lines, diff.removed, 'Nothing removed'],
          ['This Version', 'check_circle', 'text-green-600', 'bg-green-50', diff.new_lines, diff.added, 'Nothing added']].each do |heading, icon, icon_color, background, lines, changed, nothing_changed| %>
        <div>
          <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center dark:text-gray-300">
            <i class="material-icons text-xs mr-2 <%= icon_color %>"><%= icon %></i>
            <%= heading %>
          </h4>
          <div class="prose prose-sm max-w-none <%= background %> rounded-lg p-4 dark:bg-gray-900">
            <% lines.each do |line| %>
              <% case line.kind %>
              <% when :removed %>
                <p class="bg-red-100 text-red-900 px-2 py-1 rounded border-l-4 border-red-500 my-2"><del><%= line.text %></del></p>
              <% when :added %>
                <p class="bg-green-100 text-green-900 px-2 py-1 rounded border-l-4 border-green-500 my-2"><strong><%= line.text %></strong></p>
              <% when :gap %>
                <p class="text-center text-gray-400 my-2">⋯</p>
              <% else %>
                <p class="text-gray-700 my-2 dark:text-gray-300"><%= line.text %></p>
              <% end %>
            <% end %>
            <% if lines.none? { |line| line.kind == :removed || line.kind == :added } %>
              <p class="text-gray-400 italic"><%= changed.zero? ? nothing_changed : 'More changes not shown' %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-gray-600 dark:text-gray-400">
        <div class="flex items-center">
          <span class="inline-block w-12 h-3 bg-red-100 border border-red-300 rounded mr-2"></span>
          <span>Removed text</span>
        </div>
        <div class="flex items-center">
          <span class="inline-block w-12 h-3 bg-green-100 border border-green-300 rounded mr-2"></span>
          <span>Added text</span>
        </div>
        <div class="flex items-center">
          <span class="inline-block w-12 h-3 bg-gray-100 border border-gray-300 rounded mr-2"></span>
          <span>Unchanged text around the changes</span>
        </div>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      The text didn't change in this version. Changed: <%= diff.other_changes.to_sentence %>.
    </p>
  <% end %>
</div>
