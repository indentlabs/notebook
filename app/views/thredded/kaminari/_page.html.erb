<% if page.current? %>
  <span class="<%= forum_pagination_button_classes(current: true, numbered: true) %>" aria-current="page"><%= page %></span>
<% else %>
  <%= link_to page, url, remote: remote, rel: (page.next? ? 'next' : page.prev? ? 'prev' : nil), class: forum_pagination_button_classes(numbered: true) %>
<% end %>
